{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.vscode": false,
        "**/**__pycache__": true,
        "**/**atria.egg-info": true,
        "**/**.pytest_cache": true,
        "**/**.mypy_cache": true,
        "**/**.venv": false,
        "**/**.htmlcov": true,
        "**/**.ruff_cache": true,
        "**/**.coverage": true,
        "**/**uv.lock": true,
        ".copilot-docstring-instructions.md": true,
    },
    "python.analysis.indexing": true,
    "python.analysis.autoImportCompletions": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll": "explicit"
        },
        "editor.trimAutoWhitespace": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.trimTrailingWhitespace": true,
        "editor.rulers": [
            120
        ],
    },
    "github.copilot.editor.enableCodeActions": false,
    "workbench.colorCustomizations": {
        // will change the color of three dots to red
        "editorHint.foreground": "#ff0000",
        // will underline the entire word with dots in your chosen color
        "editorHint.border": "#00ff66"
    },
    "notebook.output.textLineLimit": 200,
    "notebook.output.scrolling": false,
    "github.copilot.chat.reviewSelection.instructions": [
        {
            "file": ".copilot-docstring-instructions.md",
        }
    ],
    "python.defaultInterpreterPath": "./atria_cli/.venv/bin/python",
    "python.analysis.showOnlyDirectDependenciesInAutoImport": true,
    "python.testing.pytestArgs": [
        "atria_models"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.analysis.extraPaths": [
        "atria_cli/src",
        "atria_hub/src",
        "atria_datasets/src",
        "atria_metrics/src",
        "atria_models/src",
        "atria_ml/src",
        "atria_types/src",
    ]
}